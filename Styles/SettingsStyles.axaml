<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="RadioButton.navItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RadioButton.navItem:pointerover">
        <Setter Property="Background" Value="#15f0f0f0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style Selector="RadioButton.navItem:checked">
        <Setter Property="Background" Value="{StaticResource LiquidGlassBase}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style Selector="Button.windowButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Button.windowButton:pointerover">
        <Setter Property="Background" Value="#25f0f0f0"/>
    </Style>

    <Style Selector="Button.closeButton:pointerover">
        <Setter Property="Background" Value="#e74c3c"/>
    </Style>

    <Style Selector="Button.actionButton">
        <Setter Property="Background" Value="{StaticResource ButtonGlassGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Padding" Value="15,9"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Button.actionButton:pointerover">
        <Setter Property="Background" Value="{StaticResource ButtonGlassHoverGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <Style Selector="Button.applyButton">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#25f0f8f0" Offset="0"/>
                    <GradientStop Color="#18e0e8e0" Offset="0.5"/>
                    <GradientStop Color="#10d0d8d0" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#30e0e8e0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#60c8d0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="22,9"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Button.applyButton:pointerover">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#35f5faf5" Offset="0"/>
                    <GradientStop Color="#25e5f0e5" Offset="0.5"/>
                    <GradientStop Color="#18d5e0d5" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="#70d8e0"/>
        <Setter Property="BorderBrush" Value="#40f0f8f0"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <Style Selector="Button.cancelButton">
        <Setter Property="Background" Value="{StaticResource ButtonGlassGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Padding" Value="22,9"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Button.cancelButton:pointerover">
        <Setter Property="Background" Value="{StaticResource ButtonGlassHoverGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <Style Selector="Button.resetButton">
        <Setter Property="Background" Value="{StaticResource ButtonGlassGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Padding" Value="15,9"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Button.resetButton:pointerover">
        <Setter Property="Background" Value="{StaticResource ButtonGlassHoverGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <Style Selector="Button.presetButton">
        <Setter Property="Background" Value="{StaticResource LiquidGlassBase}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Button.presetButton:pointerover">
        <Setter Property="Background" Value="{StaticResource LiquidGlassHover}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <Style Selector="RadioButton.positionButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RadioButton.positionButton:pointerover">
        <Setter Property="Background" Value="#15f0f0f0"/>
    </Style>

    <Style Selector="RadioButton.positionButton:checked">
        <Setter Property="Background" Value="{StaticResource LiquidGlassBase}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Border.colorPreset">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Border.colorPreset:pointerover">
        <Setter Property="BorderBrush" Value="#60f0f8f0"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Slider">
        <Setter Property="Foreground" Value="#60c8d0"/>
        <Setter Property="Background" Value="#15f0f0f0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource LiquidGlassBase}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderActive}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="TextBox:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="#10f0f0f0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

</Styles>