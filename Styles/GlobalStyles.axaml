<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, sans-serif"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>

    <Style Selector="TextBlock.Title">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style Selector="TextBlock.Subtitle">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>

    <Style Selector="TextBlock.Body">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>

    <Style Selector="TextBlock.Label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style Selector="TextBlock.Value">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style Selector="TextBlock.Hint">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
    </Style>

    <Style Selector="Border.glass-card">
        <Setter Property="Background" Value="{StaticResource LiquidGlassBase}"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="BoxShadow" Value="0 8 32 0 #30000000, 0 2 8 0 #10000000"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Border.glass-card:pointerover">
        <Setter Property="Background" Value="{StaticResource LiquidGlassHover}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
        <Setter Property="BoxShadow" Value="0 12 40 0 #40000000, 0 4 12 0 #20000000"/>
    </Style>

    <Style Selector="Border.glass-card:pointerpressed">
        <Setter Property="Background" Value="{StaticResource LiquidGlassPressed}"/>
        <Setter Property="BoxShadow" Value="0 4 20 0 #30000000"/>
    </Style>

    <Style Selector="Border.glass-header">
        <Setter Property="Background" Value="{StaticResource LiquidGlassBase}"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style Selector="Border.glass-isolation">
        <Setter Property="Background" Value="{StaticResource ColorIsolationLayer}"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="Button.glass-button">
        <Setter Property="Background" Value="{StaticResource ButtonGlassGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Button.glass-button:pointerover">
        <Setter Property="Background" Value="{StaticResource ButtonGlassHoverGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <Style Selector="Button.glass-button:pressed">
        <Setter Property="Background" Value="{StaticResource LiquidGlassPressed}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Button.apply-button">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#25f0f8f0" Offset="0"/>
                    <GradientStop Color="#18e0e8e0" Offset="0.5"/>
                    <GradientStop Color="#10d0d8d0" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#30e0e8e0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="Foreground" Value="#60c8d0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Button.apply-button:pointerover">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#35f5faf5" Offset="0"/>
                    <GradientStop Color="#25e5f0e5" Offset="0.5"/>
                    <GradientStop Color="#18d5e0d5" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="#70d8e0"/>
        <Setter Property="BorderBrush" Value="#40f0f8f0"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <Style Selector="Button.apply-button:pressed">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#15e0e8e0" Offset="0"/>
                    <GradientStop Color="#10d0d8d0" Offset="0.5"/>
                    <GradientStop Color="#0ac0c8c0" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="RadioButton.nav-item">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RadioButton.nav-item:checked">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource LiquidGlassBase}"/>
    </Style>

    <Style Selector="RadioButton.nav-item:pointerover">
        <Setter Property="Background" Value="#15f0f0f0"/>
    </Style>

    <Style Selector="CheckBox.glass-checkbox">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="CheckBox.glass-checkbox:pointerover">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style Selector="Slider.glass-slider">
        <Setter Property="Foreground" Value="#4ecdc4"/>
        <Setter Property="Background" Value="#15f0f0f0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="ComboBox.glass-combobox">
        <Setter Property="Background" Value="{StaticResource LiquidGlassBase}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ComboBox.glass-combobox:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <Style Selector="ComboBox.glass-combobox:focus">
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderActive}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="ProgressBar.glass-progress">
        <Setter Property="Background" Value="#15f0f0f0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Height" Value="8"/>
    </Style>

    <Style Selector="Border.colorPreset">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="#30f0f0f5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Border.colorPreset:pointerover">
        <Setter Property="BorderBrush" Value="#60f0f8f0"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="RadioButton.positionButton">
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RadioButton.positionButton:checked">
        <Setter Property="Background" Value="{StaticResource LiquidGlassBase}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="RadioButton.positionButton:pointerover">
        <Setter Property="Background" Value="#15f0f0f0"/>
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="#10f0f0f0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CaretBrush" Value="#60c8d0"/>
        <Setter Property="SelectionBrush" Value="#60c8d0"/>
        <Setter Property="SelectionForegroundBrush" Value="White"/>
        <Setter Property="Background" Value="{StaticResource LiquidGlassBase}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderActive}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="TextBox:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <Style Selector="Panel">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

</Styles>