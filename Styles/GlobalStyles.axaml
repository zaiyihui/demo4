<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 字体系统：无衬线字体 + 鲜明字号对比 ===== -->

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="Inter, Segoe UI, Microsoft YaHei UI, PingFang SC, sans-serif"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>

    <Style Selector="TextBlock.display">
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="LineHeight" Value="1.2"/>
    </Style>

    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="LineHeight" Value="1.3"/>
    </Style>

    <Style Selector="TextBlock.title-lg">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitleLG}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style Selector="TextBlock.subtitle">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>

    <Style Selector="TextBlock.body-lg">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLG}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="LineHeight" Value="1.5"/>
    </Style>

    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="LineHeight" Value="1.6"/>
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHint}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
    </Style>

    <Style Selector="TextBlock.value">
        <Setter Property="FontSize" Value="{StaticResource FontSizeValue}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Inter, Segoe UI, monospace"/>
    </Style>

    <!-- ===== 基础卡片系统：微妙半透明白边 + 浅背景区分 ===== -->

    <Style Selector="Border.glass-card">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="BoxShadow" Value="0 4 16 #18000000"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                    <BrushTransition Property="Background" Duration="0:0:0.3"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Border.glass-card:pointerover">
        <Setter Property="Background" Value="{StaticResource CardBackgroundHover}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleStrong}"/>
        <Setter Property="BoxShadow" Value="0 8 24 #20000000"/>
    </Style>

    <Style Selector="Border.glass-card:pointerpressed">
        <Setter Property="Background" Value="{StaticResource CardBackgroundActive}"/>
        <Setter Property="BoxShadow" Value="0 2 8 #10000000"/>
    </Style>

    <!-- ===== 高亮卡片：用于强调/选中区域 ===== -->

    <Style Selector="Border.glass-card-with-highlight">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="BoxShadow" Value="0 4 20 #18000000"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    </Style>

    <Style Selector="Border.glass-header">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerSubtle}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style Selector="Border.glass-isolation">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- ===== 指标卡片：监控专用，紧凑安全区 ===== -->

    <Style Selector="Border.metric-card">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="BoxShadow" Value="0 2 12 #12000000"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.25"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 按钮系统 ===== -->

    <Style Selector="Button.glass-button">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="MinWidth" Value="72"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Button.glass-button:pointerover">
        <Setter Property="Background" Value="{StaticResource CardBackgroundHover}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleStrong}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style Selector="Button.glass-button:pressed">
        <Setter Property="Background" Value="{StaticResource CardBackgroundActive}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
    </Style>

    <!-- ===== 主按钮：荧光绿强调色 ===== -->

    <Style Selector="Button.apply-button">
        <Setter Property="Background" Value="{StaticResource ButtonPrimaryGradient}"/>
        <Setter Property="BorderBrush" Value="#4000db78"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="Foreground" Value="#0d1010"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Button.apply-button:pointerover">
        <Setter Property="Background" Value="{StaticResource ButtonPrimaryHoverGradient}"/>
    </Style>

    <Style Selector="Button.apply-button:pressed">
        <Setter Property="Background" Value="{StaticResource AccentTertiary}"/>
        <Setter Property="Foreground" Value="#ffffff"/>
    </Style>

    <!-- ===== 导航菜单项 ===== -->

    <Style Selector="RadioButton.nav-item">
        <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RadioButton.nav-item:checked">
        <Setter Property="Foreground" Value="{StaticResource AccentPrimary}"/>
        <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderAccent}"/>
    </Style>

    <Style Selector="RadioButton.nav-item:pointerover">
        <Setter Property="Background" Value="{StaticResource CardBackgroundHover}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>

    <Style Selector="RadioButton.nav-item:checked:pointerover">
        <Setter Property="Foreground" Value="{StaticResource AccentPrimary}"/>
        <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
    </Style>

    <!-- ===== CheckBox ===== -->

    <Style Selector="CheckBox.glass-checkbox">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="CheckBox.glass-checkbox:pointerover">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <!-- ===== Slider：荧光绿轨道 ===== -->

    <Style Selector="Slider.glass-slider">
        <Setter Property="Foreground" Value="{StaticResource AccentPrimary}"/>
        <Setter Property="Background" Value="{StaticResource BorderSubtleStrong}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinWidth" Value="150"/>
    </Style>

    <!-- ===== ComboBox ===== -->

    <Style Selector="ComboBox.glass-combobox">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ComboBox.glass-combobox:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleStrong}"/>
        <Setter Property="Background" Value="{StaticResource CardBackgroundHover}"/>
    </Style>

    <Style Selector="ComboBox.glass-combobox:focus">
        <Setter Property="BorderBrush" Value="{StaticResource BorderAccent}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ===== ProgressBar ===== -->

    <Style Selector="ProgressBar.glass-progress-bar">
        <Setter Property="Background" Value="{StaticResource BorderSubtleStrong}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Height" Value="6"/>
    </Style>

    <!-- ===== 颜色预设按钮 ===== -->

    <Style Selector="Border.colorPreset">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BoxShadow" Value="0 1 4 #0a000000"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Border.colorPreset:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleStrong}"/>
    </Style>

    <!-- ===== 位置选择按钮 ===== -->

    <Style Selector="RadioButton.positionButton">
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RadioButton.positionButton:checked">
        <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderAccent}"/>
    </Style>

    <Style Selector="RadioButton.positionButton:pointerover">
        <Setter Property="Background" Value="{StaticResource CardBackgroundHover}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>

    <Style Selector="RadioButton.positionButton:checked:pointerover">
        <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentPrimary}"/>
    </Style>

    <!-- ===== 滚动系统 ===== -->

    <Style Selector="ScrollViewer">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Width" Value="6"/>
        <Setter Property="Height" Value="6"/>
    </Style>

    <Style Selector="Thumb">
        <Setter Property="Background" Value="{StaticResource BorderSubtleStrong}"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>

    <Style Selector="Thumb:pointerover">
        <Setter Property="Background" Value="{StaticResource TextTertiary}"/>
    </Style>

    <!-- ===== TextBox ===== -->

    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="Inter, Segoe UI, Microsoft YaHei UI, sans-serif"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentPrimary}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentSoft}"/>
        <Setter Property="SelectionForegroundBrush" Value="{StaticResource AccentPrimary}"/>
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{StaticResource BorderAccent}"/>
        <Setter Property="Background" Value="{StaticResource CardBackgroundHover}"/>
    </Style>

    <Style Selector="TextBox:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleStrong}"/>
    </Style>

    <!-- ===== 全局面板默认透明 ===== -->

    <Style Selector="Panel">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- ===== 指标标签 ===== -->
    <Style Selector="TextBlock.metric-label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
    </Style>

    <!-- ===== Z轴堆叠卡片：透视空间感 ===== -->
    <!-- 堆叠层-1：最底层，位移最大，阴影最深 -->
    <Style Selector="Border.stack-layer-3">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Opacity" Value="0.5"/>
    </Style>

    <!-- 堆叠层-2：中间层 -->
    <Style Selector="Border.stack-layer-2">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Opacity" Value="0.7"/>
    </Style>

    <!-- 堆叠层-1：接近顶层 -->
    <Style Selector="Border.stack-layer-1">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Opacity" Value="0.85"/>
    </Style>

    <!-- ===== 底部导航条：玻璃拟态 + 发光渐变 ===== -->
    <Style Selector="Border.bottom-nav">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="Opacity" Value="0.92"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="16,10"/>
    </Style>

    <!-- 底部导航发光边缘：顶部微小荧光绿渐变 -->
    <Style Selector="Border.bottom-nav-glow">
        <Setter Property="Height" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <!-- ===== 细分隔线：细条状线框分割 ===== -->
    <Style Selector="Border.divider-h">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource DividerSubtle}"/>
    </Style>

    <Style Selector="Border.divider-v">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Background" Value="{StaticResource DividerSubtle}"/>
    </Style>

    <Style Selector="Border.divider-strong">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource DividerStrong}"/>
    </Style>

    <!-- ===== 卡片顶部微弱高光：增强内阴影质感 ===== -->
    <Style Selector="Border.card-highlight-top">
        <Setter Property="Height" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="12,0"/>
    </Style>

    <!-- ===== 卡片左侧微弱高光 ===== -->
    <Style Selector="Border.card-highlight-left">
        <Setter Property="Width" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,10"/>
    </Style>

    <!-- ===== 强调文本：荧光绿文本 ===== -->
    <Style Selector="TextBlock.text-accent">
        <Setter Property="Foreground" Value="{StaticResource AccentPrimary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ===== 窗口外容器：背景 + 圆角 + 外阴影 ===== -->
    <Style Selector="Border.window-shell">
        <Setter Property="Background" Value="{StaticResource BackgroundPrimary}"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BoxShadow" Value="0 20 60 #40000000, 0 8 20 #20000000"/>
    </Style>

    <!-- ===== 进度条：荧光绿填充 ===== -->
    <Style Selector="ProgressBar.progress-accent">
        <Setter Property="Foreground" Value="{StaticResource AccentPrimary}"/>
        <Setter Property="Background" Value="{StaticResource BorderSubtleStrong}"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Height" Value="5"/>
    </Style>

</Styles>