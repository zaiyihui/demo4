<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ComputerCompanion.ViewModels"
        xmlns:controls="using:Avalonia.Controls"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:converters="using:ComputerCompanion.Converters"
        xmlns:media="using:Avalonia.Media"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="ComputerCompanion.Views.PerformanceDashboardWindow"
        x:DataType="vm:PerformanceDashboardViewModel"
        Title="监控面板"
        Width="1000"
        Height="700"
        MinWidth="800"
        MinHeight="600"
        Background="Transparent"
        SystemDecorations="BorderOnly"
        TransparencyLevelHint="Blur">

    <Window.Styles>
        <Style Selector="TextBlock.metric-label">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style Selector="Border.metric-card">
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLG}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="{StaticResource SpacingLG}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="MinHeight" Value="140"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                        <BrushTransition Property="Background" Duration="0:0:0.35"/>
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.35"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Border.metric-card:pointerover">
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <Style Selector="Border.glass-card-with-highlight">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BoxShadow" Value="0 4 16 #18000000"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                        <BrushTransition Property="Background" Duration="0:0:0.3"/>
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Border.glass-card-with-highlight:pointerover">
            <Setter Property="Background" Value="{StaticResource CardBackgroundHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleStrong}"/>
            <Setter Property="BoxShadow" Value="0 8 24 #25000000"/>
        </Style>

        <Style Selector="Border.glass-header-bar">
            <Setter Property="Background" Value="{StaticResource BackgroundSecondary}"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerSubtle}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style Selector="Button.glass-action-button">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                        <BrushTransition Property="Background" Duration="0:0:0.2"/>
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                        <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Button.glass-action-button:pointerover">
            <Setter Property="Background" Value="{StaticResource CardBackgroundHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleStrong}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style Selector="Button.glass-action-button:pressed">
            <Setter Property="Background" Value="{StaticResource CardBackgroundActive}"/>
        </Style>

        <!-- 窗口控制按钮样式 -->
        <Style Selector="Button.window-control-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.15"/>
                        <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Button.window-control-button:pointerover">
            <Setter Property="Background" Value="#15ffffff"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style Selector="Button.window-control-button.close:pointerover">
            <Setter Property="Background" Value="#e84343"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="ProgressBar.glass-progress-bar">
            <Setter Property="Background" Value="{StaticResource BorderSubtleStrong}"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Height" Value="5"/>
        </Style>

        <Style Selector="CheckBox.glass-checkbox-item">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="CheckBox.glass-checkbox-item:pointerover">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style Selector="ComboBox.glass-dropdown">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style Selector="ComboBox.glass-dropdown:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleStrong}"/>
            <Setter Property="Background" Value="{StaticResource CardBackgroundHover}"/>
        </Style>
    </Window.Styles>

    <Grid>
        <!-- 外层暗黑容器 - 深灰背景 + 微妙边框 + 空间阴影 -->
        <Border Background="{DynamicResource WindowBackground}"
                CornerRadius="20"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                BoxShadow="0 24 70 #45000000, 0 10 30 #25000000"
                Margin="0">
            <Border.Transitions>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.4"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
                </Transitions>
            </Border.Transitions>
            <Grid>
                <!-- 顶部边缘微光（Alpha通道编码透明度） -->
                <Border Height="1" VerticalAlignment="Top" Opacity="0.6" Margin="20,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#2600db78" Offset="0"/>
                            <GradientStop Color="#14ffffff" Offset="0.5"/>
                            <GradientStop Color="#2600db78" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 主内容区域 -->
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 顶部标题栏 - 中灰卡片 + 底部分隔线 -->
                    <Border Grid.Row="0" Background="{StaticResource BackgroundSecondary}"
                            BorderBrush="{StaticResource DividerSubtle}"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,0"
                            PointerPressed="OnTitleBarPointerPressed"
                            DoubleTapped="OnTitleBarDoubleTapped">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <!-- 左侧：Logo和标题 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" Margin="20,15" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource CpuGlassGradient}" 
                                        BoxShadow="0 4 12 #2000db78">
                                    <Grid>
                                        <Border CornerRadius="10" Background="Transparent" BorderBrush="{StaticResource BorderAccent}" BorderThickness="1"/>
                                        <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="监控面板" Classes="title"/>
                                    <TextBlock Text="实时系统性能分析与监控" Classes="caption" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 中间：状态信息 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="{StaticResource CardBackground}"
                                        BorderBrush="{StaticResource BorderSubtle}"
                                        BorderThickness="1"
                                        Padding="10,5" CornerRadius="10">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="{Binding StatusColor}" BoxShadow="0 0 8 #3000db78"/>
                                        <TextBlock Text="{Binding SystemStatus}" FontSize="11" Foreground="{Binding StatusColor}" VerticalAlignment="Center" FontWeight="Medium"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding LastUpdate, StringFormat='最后更新: {0:HH:mm:ss}'}" Classes="caption" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 右侧：功能按钮 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Classes="glass-action-button" ToolTip.Tip="刷新数据" Click="OnRefreshClick">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="🔄" FontSize="14"/>
                                        <TextBlock Text="刷新" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="glass-action-button" ToolTip.Tip="导出数据" Click="OnExportClick">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="📥" FontSize="14"/>
                                        <TextBlock Text="导出" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="glass-action-button" ToolTip.Tip="主题切换" Click="OnThemeToggleClick">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="🌙" FontSize="14"/>
                                        <TextBlock Text="主题" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- 最右侧：系统窗口控制按钮 -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Classes="window-control-button" ToolTip.Tip="最小化" Click="OnMinimizeClick" Width="46" Height="40">
                                    <TextBlock Text="−" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button Classes="window-control-button" ToolTip.Tip="最大化" Click="OnMaximizeClick" Width="46" Height="40">
                                    <TextBlock Text="□" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button Classes="window-control-button close" ToolTip.Tip="关闭" Click="OnCloseClick" Width="46" Height="40">
                                    <TextBlock Text="×" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

            <!-- 主内容区域 -->
            <Grid Grid.Row="1" ColumnDefinitions="280,*,15" Margin="{StaticResource SpacingLG}">
                <!-- 左侧：实时指标卡片 -->
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxWidth="320">
                    <StackPanel Spacing="{StaticResource SpacingLGValue}">
                        <!-- CPU 指标卡片 -->
                        <Grid>
                            <!-- Z轴堆叠底层 -->
                            <Border Classes="stack-layer-3" Margin="8,10,4,2" RenderTransform="matrix(0.98,0,0,0.98,0,4)"/>
                            <!-- Z轴堆叠中层 -->
                            <Border Classes="stack-layer-2" Margin="4,6,2,1" Opacity="0.75" RenderTransform="matrix(0.99,0,0,0.99,0,2)"/>
                            <!-- 顶层内容卡片 -->
                            <Border Classes="metric-card" IsVisible="{Binding ShowCpu}"
                                    Background="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToBackgroundConverter.Instance}, ConverterParameter=CPU}"
                                    BorderBrush="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToBorderConverter.Instance}, ConverterParameter=CPU}"
                                    BoxShadow="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToShadowConverter.Instance}, ConverterParameter=CPU}"
                                    Opacity="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToOpacityConverter.Instance}, ConverterParameter=CPU}"
                                    PointerPressed="OnMetricCardClicked" Tag="CPU">
                                <Border.RenderTransform>
                                    <media:ScaleTransform ScaleX="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToScaleConverter.Instance}, ConverterParameter=CPU}"
                                                    ScaleY="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToScaleConverter.Instance}, ConverterParameter=CPU}"/>
                                </Border.RenderTransform>
                                <Grid>
                                    <!-- 微弱顶部高光（Alpha通道编码透明度） -->
                                    <Border Height="1" VerticalAlignment="Top" Opacity="0.35" Margin="12,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#0fffffff" Offset="0"/>
                                                <GradientStop Color="#08ffffff" Offset="0.5"/>
                                                <GradientStop Color="#00ffffff" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <!-- 微弱左侧高光 -->
                                    <Border Width="1" HorizontalAlignment="Left" Opacity="0.25" Margin="0,10">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#0fffffff" Offset="0"/>
                                                <GradientStop Color="#00ffffff" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Spacing="{StaticResource SpacingMDValue}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSMValue}">
                                                <Border Width="24" Height="24" CornerRadius="{StaticResource RadiusSM}" Background="{StaticResource CpuGlassGradient}">
                                                    <TextBlock Text="C" FontSize="{StaticResource FontSizeBody}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="CPU" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding CpuUsage, StringFormat={}{0:F1}%}" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource AccentPrimary}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:F1}%}" Classes="value" Foreground="{StaticResource TextPrimary}"/>
                                        <ProgressBar Value="{Binding CpuUsage}" Maximum="100" Classes="glass-progress-bar" Foreground="{StaticResource AccentPrimary}"/>

                                        <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                                            <StackPanel>
                                                <TextBlock Text="温度" Classes="metric-label"/>
                                                <TextBlock Text="{Binding CpuTemperature, StringFormat={}{0:F0}°C}" FontSize="{StaticResource FontSizeBodyLG}" Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="状态" Classes="metric-label"/>
                                                <TextBlock Text="正常" FontSize="{StaticResource FontSizeBodyLG}" Foreground="{StaticResource AccentPrimary}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- GPU 指标卡片 -->
                        <Grid>
                            <!-- Z轴堆叠底层 -->
                            <Border Classes="stack-layer-3" Margin="8,10,4,2" RenderTransform="matrix(0.98,0,0,0.98,0,4)"/>
                            <!-- Z轴堆叠中层 -->
                            <Border Classes="stack-layer-2" Margin="4,6,2,1" Opacity="0.75" RenderTransform="matrix(0.99,0,0,0.99,0,2)"/>
                            <Border Classes="metric-card" IsVisible="{Binding ShowGpu}"
                                    Background="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToBackgroundConverter.Instance}, ConverterParameter=GPU}"
                                    BorderBrush="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToBorderConverter.Instance}, ConverterParameter=GPU}"
                                    BoxShadow="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToShadowConverter.Instance}, ConverterParameter=GPU}"
                                    Opacity="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToOpacityConverter.Instance}, ConverterParameter=GPU}"
                                    PointerPressed="OnMetricCardClicked" Tag="GPU">
                                <Border.RenderTransform>
                                    <media:ScaleTransform ScaleX="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToScaleConverter.Instance}, ConverterParameter=GPU}"
                                                    ScaleY="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToScaleConverter.Instance}, ConverterParameter=GPU}"/>
                                </Border.RenderTransform>
                                <Grid>
                                    <!-- 微弱顶部高光（Alpha通道编码透明度） -->
                                    <Border Height="1" VerticalAlignment="Top" Opacity="0.35" Margin="12,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#0fffffff" Offset="0"/>
                                                <GradientStop Color="#08ffffff" Offset="0.5"/>
                                                <GradientStop Color="#00ffffff" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <!-- 微弱左侧高光 -->
                                    <Border Width="1" HorizontalAlignment="Left" Opacity="0.25" Margin="0,10">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#0fffffff" Offset="0"/>
                                                <GradientStop Color="#00ffffff" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Spacing="{StaticResource SpacingMDValue}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSMValue}">
                                                <Border Width="24" Height="24" CornerRadius="{StaticResource RadiusSM}" Background="{StaticResource GpuGlassGradient}">
                                                    <TextBlock Text="G" FontSize="{StaticResource FontSizeBody}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="GPU" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold" Foreground="{StaticResource AccentSecondary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding GpuUsage, StringFormat={}{0:F1}%}" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource AccentSecondary}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <TextBlock Text="{Binding GpuUsage, StringFormat={}{0:F1}%}" Classes="value" Foreground="{StaticResource TextPrimary}"/>
                                        <ProgressBar Value="{Binding GpuUsage}" Maximum="100" Classes="glass-progress-bar" Foreground="{StaticResource AccentSecondary}"/>

                                        <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                                            <StackPanel>
                                                <TextBlock Text="温度" Classes="metric-label"/>
                                                <TextBlock Text="{Binding GpuTemperature, StringFormat={}{0:F0}°C}" FontSize="{StaticResource FontSizeBodyLG}" Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="状态" Classes="metric-label"/>
                                                <TextBlock Text="正常" FontSize="{StaticResource FontSizeBodyLG}" Foreground="{StaticResource AccentPrimary}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 内存指标卡片 -->
                        <Grid>
                            <!-- Z轴堆叠底层 -->
                            <Border Classes="stack-layer-3" Margin="8,10,4,2" RenderTransform="matrix(0.98,0,0,0.98,0,4)"/>
                            <!-- Z轴堆叠中层 -->
                            <Border Classes="stack-layer-2" Margin="4,6,2,1" Opacity="0.75" RenderTransform="matrix(0.99,0,0,0.99,0,2)"/>
                            <Border Classes="metric-card" IsVisible="{Binding ShowMemory}"
                                    Background="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToBackgroundConverter.Instance}, ConverterParameter=Memory}"
                                    BorderBrush="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToBorderConverter.Instance}, ConverterParameter=Memory}"
                                    BoxShadow="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToShadowConverter.Instance}, ConverterParameter=Memory}"
                                    Opacity="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToOpacityConverter.Instance}, ConverterParameter=Memory}"
                                    PointerPressed="OnMetricCardClicked" Tag="Memory">
                                <Border.RenderTransform>
                                    <media:ScaleTransform ScaleX="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToScaleConverter.Instance}, ConverterParameter=Memory}"
                                                    ScaleY="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToScaleConverter.Instance}, ConverterParameter=Memory}"/>
                                </Border.RenderTransform>
                                <Grid>
                                    <!-- 微弱顶部高光（Alpha通道编码透明度） -->
                                    <Border Height="1" VerticalAlignment="Top" Opacity="0.35" Margin="12,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#0fffffff" Offset="0"/>
                                                <GradientStop Color="#08ffffff" Offset="0.5"/>
                                                <GradientStop Color="#00ffffff" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <!-- 微弱左侧高光 -->
                                    <Border Width="1" HorizontalAlignment="Left" Opacity="0.25" Margin="0,10">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#0fffffff" Offset="0"/>
                                                <GradientStop Color="#00ffffff" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Spacing="{StaticResource SpacingMDValue}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSMValue}">
                                                <Border Width="24" Height="24" CornerRadius="{StaticResource RadiusSM}" Background="{StaticResource MemoryGlassGradient}">
                                                    <TextBlock Text="M" FontSize="{StaticResource FontSizeBody}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="内存" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold" Foreground="{StaticResource AccentTertiary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding MemoryUsage, StringFormat={}{0:F1}%}" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource AccentTertiary}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <TextBlock Text="{Binding MemoryUsage, StringFormat={}{0:F1}%}" Classes="value" Foreground="{StaticResource TextPrimary}"/>
                                        <ProgressBar Value="{Binding MemoryUsage}" Maximum="100" Classes="glass-progress-bar" Foreground="{StaticResource AccentTertiary}"/>

                                        <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                                            <StackPanel>
                                                <TextBlock Text="已用" Classes="metric-label"/>
                                                <TextBlock Text="{Binding MemoryUsedGB, StringFormat={}{0:F1} GB}" FontSize="{StaticResource FontSizeBodyLG}" Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="总计" Classes="metric-label"/>
                                                <TextBlock Text="{Binding MemoryTotalGB, StringFormat={}{0:F1} GB}" FontSize="{StaticResource FontSizeBodyLG}" Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- FPS 指标卡片 -->
                        <Grid>
                            <!-- Z轴堆叠底层 -->
                            <Border Classes="stack-layer-3" Margin="8,10,4,2" RenderTransform="matrix(0.98,0,0,0.98,0,4)"/>
                            <!-- Z轴堆叠中层 -->
                            <Border Classes="stack-layer-2" Margin="4,6,2,1" Opacity="0.75" RenderTransform="matrix(0.99,0,0,0.99,0,2)"/>
                            <Border Classes="metric-card" IsVisible="{Binding ShowFps}"
                                    Background="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToBackgroundConverter.Instance}, ConverterParameter=FPS}"
                                    BorderBrush="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToBorderConverter.Instance}, ConverterParameter=FPS}"
                                    BoxShadow="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToShadowConverter.Instance}, ConverterParameter=FPS}"
                                    Opacity="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToOpacityConverter.Instance}, ConverterParameter=FPS}"
                                    PointerPressed="OnMetricCardClicked" Tag="FPS">
                                <Border.RenderTransform>
                                    <media:ScaleTransform ScaleX="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToScaleConverter.Instance}, ConverterParameter=FPS}"
                                                    ScaleY="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToScaleConverter.Instance}, ConverterParameter=FPS}"/>
                                </Border.RenderTransform>
                                <Grid>
                                    <!-- 微弱顶部高光（Alpha通道编码透明度） -->
                                    <Border Height="1" VerticalAlignment="Top" Opacity="0.35" Margin="12,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#0fffffff" Offset="0"/>
                                                <GradientStop Color="#08ffffff" Offset="0.5"/>
                                                <GradientStop Color="#00ffffff" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <!-- 微弱左侧高光 -->
                                    <Border Width="1" HorizontalAlignment="Left" Opacity="0.25" Margin="0,10">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#0fffffff" Offset="0"/>
                                                <GradientStop Color="#00ffffff" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Spacing="{StaticResource SpacingMDValue}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSMValue}">
                                                <Border Width="24" Height="24" CornerRadius="{StaticResource RadiusSM}" Background="{StaticResource FpsGlassGradient}">
                                                    <TextBlock Text="F" FontSize="{StaticResource FontSizeBody}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="FPS" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding Fps, Converter={x:Static converters:FpsValueConverter.Instance}}" Classes="value" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="帧/秒" Classes="metric-label" Margin="0,-2,0,0"/>

                                        <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                                            <StackPanel>
                                                <TextBlock Text="响应时间" Classes="metric-label"/>
                                                <TextBlock Text="{Binding AvgResponseTime, StringFormat={}{0:F1} ms}" FontSize="{StaticResource FontSizeBodyLG}" Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="错误/分钟" Classes="metric-label"/>
                                                <TextBlock Text="{Binding ErrorsPerMinute}" FontSize="{StaticResource FontSizeBodyLG}" Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 指标过滤 -->
                        <Border Classes="glass-card-with-highlight">
                            <StackPanel Spacing="{StaticResource SpacingMDValue}">
                                <TextBlock Text="显示指标" FontSize="{StaticResource FontSizeBodyLG}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <StackPanel Spacing="{StaticResource SpacingXSValue}">
                                    <CheckBox Content="CPU" IsChecked="{Binding ShowCpu}" Tag="CPU" Classes="glass-checkbox-item" Foreground="{StaticResource AccentPrimary}"/>
                                    <CheckBox Content="GPU" IsChecked="{Binding ShowGpu}" Tag="GPU" Classes="glass-checkbox-item" Foreground="{StaticResource AccentSecondary}"/>
                                    <CheckBox Content="内存" IsChecked="{Binding ShowMemory}" Tag="Memory" Classes="glass-checkbox-item" Foreground="{StaticResource AccentTertiary}"/>
                                    <CheckBox Content="FPS" IsChecked="{Binding ShowFps}" Tag="FPS" Classes="glass-checkbox-item" Foreground="{StaticResource AccentPrimary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 右侧：图表和告警 -->
                <Grid Grid.Column="1" RowDefinitions="*,Auto">
                    <!-- 图表区域 -->
                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="{StaticResource SpacingLGValue}">
                            <!-- 时间范围选择 -->
                            <Border Classes="glass-card-with-highlight">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingLGValue}" VerticalAlignment="Center">
                                    <TextBlock Text="时间范围" FontSize="{StaticResource FontSizeBodyLG}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                    <ComboBox SelectedIndex="2" Width="140" Classes="glass-dropdown" SelectionChanged="OnTimeRangeChanged">
                                        <ComboBoxItem Content="15分钟"/>
                                        <ComboBoxItem Content="30分钟"/>
                                        <ComboBoxItem Content="1小时"/>
                                        <ComboBoxItem Content="6小时"/>
                                        <ComboBoxItem Content="24小时"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <!-- CPU 图表 -->
                            <Border Classes="glass-card-with-highlight" IsVisible="{Binding ShowCpu}">
                                <StackPanel Spacing="{StaticResource SpacingMDValue}">
                                    <Border Height="1" VerticalAlignment="Top" Opacity="0.25" Margin="0,0,0,8">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00db78" Offset="0"/>
                                                <GradientStop Color="#4d00db78" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="CPU 使用率趋势" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimary}"/>
                                    <lvc:CartesianChart Series="{Binding CpuSeries}" XAxes="{Binding DefaultXAxes}" YAxes="{Binding DefaultYAxes}" Height="180" Background="Transparent"/>
                                </StackPanel>
                            </Border>

                            <!-- GPU 图表 -->
                            <Border Classes="glass-card-with-highlight" IsVisible="{Binding ShowGpu}">
                                <StackPanel Spacing="{StaticResource SpacingMDValue}">
                                    <Border Height="1" VerticalAlignment="Top" Opacity="0.25" Margin="0,0,0,8">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00e8a8" Offset="0"/>
                                                <GradientStop Color="#4d00e8a8" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="GPU 使用率趋势" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold" Foreground="{StaticResource AccentSecondary}"/>
                                    <lvc:CartesianChart Series="{Binding GpuSeries}" XAxes="{Binding DefaultXAxes}" YAxes="{Binding DefaultYAxes}" Height="180" Background="Transparent"/>
                                </StackPanel>
                            </Border>

                            <!-- 内存图表 -->
                            <Border Classes="glass-card-with-highlight" IsVisible="{Binding ShowMemory}">
                                <StackPanel Spacing="{StaticResource SpacingMDValue}">
                                    <Border Height="1" VerticalAlignment="Top" Opacity="0.25" Margin="0,0,0,8">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00d4aa" Offset="0"/>
                                                <GradientStop Color="#4d00d4aa" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="内存使用率趋势" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold" Foreground="{StaticResource AccentTertiary}"/>
                                    <lvc:CartesianChart Series="{Binding MemorySeries}" XAxes="{Binding DefaultXAxes}" YAxes="{Binding DefaultYAxes}" Height="180" Background="Transparent"/>
                                </StackPanel>
                            </Border>

                            <!-- FPS 图表 -->
                            <Border Classes="glass-card-with-highlight" IsVisible="{Binding ShowFps}">
                                <StackPanel Spacing="{StaticResource SpacingMDValue}">
                                    <Border Height="1" VerticalAlignment="Top" Opacity="0.25" Margin="0,0,0,8">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00db78" Offset="0"/>
                                                <GradientStop Color="#4d00db78" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="FPS 帧率趋势" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimary}"/>
                                    <lvc:CartesianChart Series="{Binding FpsSeries}" XAxes="{Binding DefaultXAxes}" YAxes="{Binding FpsYAxes}" Height="180" Background="Transparent"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 告警区域 -->
                    <Border Grid.Row="1" Classes="glass-card-with-highlight" Margin="0,16,0,0" MaxHeight="220">
                        <StackPanel Spacing="{StaticResource SpacingMDValue}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="活动告警" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="{StaticResource BackgroundSecondary}"
                                        BorderBrush="{StaticResource BorderSubtle}"
                                        BorderThickness="1" Padding="8,4" CornerRadius="8">
                                    <TextBlock Text="{Binding ActiveAlerts.Count, StringFormat={}{0} 个告警}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding ActiveAlerts}" MaxHeight="160">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" CornerRadius="10" Background="{StaticResource BackgroundSecondary}"
                                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="12">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Width="6" Height="6" CornerRadius="3" Background="{Binding SeverityColor}" 
                                                        BoxShadow="0 0 8 #40ff6b6b" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding RuleName}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Message}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="280"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding TimeAgo}" FontSize="{StaticResource FontSizeHint}" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 底部状态栏：中灰卡片 + 顶部荧光绿发光渐变（Alpha通道编码透明度） -->
            <Grid Grid.Row="2">
                <!-- 顶部发光边缘 -->
                <Border Height="1" VerticalAlignment="Top" Opacity="0.7">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0000db78" Offset="0"/>
                            <GradientStop Color="#8000db78" Offset="0.3"/>
                            <GradientStop Color="#b300e8a8" Offset="0.5"/>
                            <GradientStop Color="#8000db78" Offset="0.7"/>
                            <GradientStop Color="#0000db78" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border Background="{StaticResource BackgroundSecondary}"
                        BorderBrush="{StaticResource DividerSubtle}"
                        BorderThickness="0,1,0,0"
                        Padding="20,10" Margin="0,1,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="监控面板 v2.0" Classes="metric-label"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <Border Background="{StaticResource CardBackground}"
                                    BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="1" Padding="10,4" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="CPU:" Classes="metric-label" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:F1}%}" FontSize="{StaticResource FontSizeBodyLG}" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimary}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource CardBackground}"
                                    BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="1" Padding="10,4" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="内存:" Classes="metric-label" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MemoryUsage, StringFormat={}{0:F1}%}" FontSize="{StaticResource FontSizeBodyLG}" FontWeight="SemiBold" Foreground="{StaticResource AccentTertiary}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource CardBackground}"
                                    BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="1" Padding="10,4" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="FPS:" Classes="metric-label" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Fps, Converter={x:Static converters:FpsValueConverter.Instance}}" FontSize="{StaticResource FontSizeBodyLG}" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimary}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>