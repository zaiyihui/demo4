<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ComputerCompanion.ViewModels"
        xmlns:controls="using:Avalonia.Controls"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:converters="using:ComputerCompanion.Converters"
        xmlns:media="using:Avalonia.Media"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="ComputerCompanion.Views.PerformanceDashboardWindow"
        x:DataType="vm:PerformanceDashboardViewModel"
        Title="监控面板"
        Width="1000"
        Height="700"
        MinWidth="800"
        MinHeight="600"
        Background="Transparent"
        SystemDecorations="BorderOnly"
        TransparencyLevelHint="Blur">

    <Window.Styles>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style Selector="TextBlock.subtitle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>

        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
        </Style>

        <Style Selector="Border.metric-card">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                        <BrushTransition Property="Background" Duration="0:0:0.35"/>
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.35"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Border.metric-card:pointerover">
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <Style Selector="Border.glass-card-with-highlight">
            <Setter Property="Background" Value="{StaticResource LiquidGlassBase}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BoxShadow" Value="0 12 40 0 #50000000, 0 4 15 0 #30000000, inset 0 1 0 0 #40ffffff"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                        <BrushTransition Property="Background" Duration="0:0:0.3"/>
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Border.glass-card-with-highlight:pointerover">
            <Setter Property="Background" Value="{StaticResource LiquidGlassHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
            <Setter Property="BoxShadow" Value="0 16 50 0 #60000000, 0 6 20 0 #40000000, inset 0 1 0 0 #50ffffff"/>
            <Setter Property="BorderThickness" Value="2.5"/>
        </Style>

        <Style Selector="Border.glass-header-bar">
            <Setter Property="Background" Value="{StaticResource LiquidGlassBase}"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style Selector="Button.glass-action-button">
            <Setter Property="Background" Value="{StaticResource LiquidGlassBase}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                        <BrushTransition Property="Background" Duration="0:0:0.25"/>
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
                        <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Button.glass-action-button:pointerover">
            <Setter Property="Background" Value="{StaticResource LiquidGlassHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <Style Selector="Button.glass-action-button:pressed">
            <Setter Property="Background" Value="{StaticResource LiquidGlassPressed}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 窗口控制按钮样式 -->
        <Style Selector="Button.window-control-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.15"/>
                        <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Button.window-control-button:pointerover">
            <Setter Property="Background" Value="#15ffffff"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style Selector="Button.window-control-button.close:pointerover">
            <Setter Property="Background" Value="#e84343"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="ProgressBar.glass-progress-bar">
            <Setter Property="Background" Value="#15ffffff"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Height" Value="6"/>
        </Style>

        <Style Selector="CheckBox.glass-checkbox-item">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="CheckBox.glass-checkbox-item:pointerover">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style Selector="ComboBox.glass-dropdown">
            <Setter Property="Background" Value="{StaticResource LiquidGlassBase}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style Selector="ComboBox.glass-dropdown:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
        </Style>
    </Window.Styles>

    <Grid>
        <!-- 外层厚玻璃容器 - 增强的液态玻璃质感 -->
        <Border Background="{DynamicResource WindowBackground}"
                CornerRadius="24"
                BorderBrush="{StaticResource ThickGlassBorder}"
                BorderThickness="1.5"
                BoxShadow="0 24 70 0 #45000000, 0 10 30 0 #25000000, inset 0 0 50 0 #15000000"
                Margin="0">
            <Border.Transitions>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.4"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
                </Transitions>
            </Border.Transitions>
            <Grid>
                <!-- 顶部厚玻璃高光层 -->
                <Border Height="60" VerticalAlignment="Top" Background="{StaticResource ThickGlassHighlight}" Margin="0"/>
                
                <!-- 底部暗化层 -->
                <Border Height="30" VerticalAlignment="Bottom" Background="{StaticResource ThickGlassBottomDark}" Margin="0"/>
                
                <!-- 左侧边缘高光 -->
                <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource ThickGlassHighlight}" Margin="0"/>
                
                <!-- 主内容区域 -->
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 顶部标题栏 -->
                    <Border Grid.Row="0" Classes="glass-header-bar" Padding="0,0,0,0" PointerPressed="OnTitleBarPointerPressed" DoubleTapped="OnTitleBarDoubleTapped">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <!-- 左侧：Logo和标题 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" Margin="20,15" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource CpuGlassGradient}" 
                                        BoxShadow="0 4 12 0 #204ecdc4">
                                    <Grid>
                                        <Border CornerRadius="10" Background="Transparent" BorderBrush="#40ffffff" BorderThickness="1"/>
                                        <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="监控面板" Classes="title"/>
                                    <TextBlock Text="实时系统性能分析与监控" Classes="subtitle" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 中间：状态信息 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Classes="glass-card-with-highlight" Padding="12,6" CornerRadius="16">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{Binding StatusColor}" BoxShadow="0 0 10 0 #4ecdc4"/>
                                        <TextBlock Text="{Binding SystemStatus}" FontSize="13" Foreground="{Binding StatusColor}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding LastUpdate, StringFormat='最后更新: {0:HH:mm:ss}'}" Classes="label" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 右侧：功能按钮 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Classes="glass-action-button" ToolTip.Tip="刷新数据" Click="OnRefreshClick">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="🔄" FontSize="14"/>
                                        <TextBlock Text="刷新" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="glass-action-button" ToolTip.Tip="导出数据" Click="OnExportClick">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="📥" FontSize="14"/>
                                        <TextBlock Text="导出" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="glass-action-button" ToolTip.Tip="主题切换" Click="OnThemeToggleClick">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="🌙" FontSize="14"/>
                                        <TextBlock Text="主题" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- 最右侧：系统窗口控制按钮 -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Classes="window-control-button" ToolTip.Tip="最小化" Click="OnMinimizeClick" Width="46" Height="40">
                                    <TextBlock Text="−" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button Classes="window-control-button" ToolTip.Tip="最大化" Click="OnMaximizeClick" Width="46" Height="40">
                                    <TextBlock Text="□" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button Classes="window-control-button close" ToolTip.Tip="关闭" Click="OnCloseClick" Width="46" Height="40">
                                    <TextBlock Text="×" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

            <!-- 主内容区域 -->
            <Grid Grid.Row="1" ColumnDefinitions="280,*" Margin="15">
                <!-- 左侧：实时指标卡片 -->
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <!-- CPU 指标卡片 -->
                        <Border Classes="metric-card" IsVisible="{Binding ShowCpu}"
                                Background="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToBackgroundConverter.Instance}, ConverterParameter=CPU}"
                                BorderBrush="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToBorderConverter.Instance}, ConverterParameter=CPU}"
                                BoxShadow="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToShadowConverter.Instance}, ConverterParameter=CPU}"
                                Opacity="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToOpacityConverter.Instance}, ConverterParameter=CPU}"
                                PointerPressed="OnMetricCardClicked" Tag="CPU">
                            <Border.RenderTransform>
                                <media:ScaleTransform ScaleX="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToScaleConverter.Instance}, ConverterParameter=CPU}"
                                                ScaleY="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToScaleConverter.Instance}, ConverterParameter=CPU}"/>
                            </Border.RenderTransform>
                            <Grid>
                                <Border Height="1" VerticalAlignment="Top" Background="{StaticResource GlassHighlightTop}" Margin="10,0"/>
                                <Border Width="1" HorizontalAlignment="Left" Background="{StaticResource GlassHighlightLeft}" Margin="0,10"/>
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="24" Height="24" CornerRadius="8" Background="{StaticResource CpuGlassGradient}">
                                                <TextBlock Text="C" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="CPU" FontSize="14" FontWeight="SemiBold" Foreground="#4ecdc4" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding CpuUsage, StringFormat={}{0:F1}%}" FontSize="12" Foreground="#4ecdc4" VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:F1}%}" Classes="value" Foreground="{StaticResource TextPrimary}"/>
                                    <ProgressBar Value="{Binding CpuUsage}" Maximum="100" Classes="glass-progress-bar" Foreground="#4ecdc4"/>

                                    <Grid ColumnDefinitions="*,*" Margin="0,5,0,0">
                                        <StackPanel>
                                            <TextBlock Text="温度" Classes="label"/>
                                            <TextBlock Text="{Binding CpuTemperature, StringFormat={}{0:F0}°C}" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="状态" Classes="label"/>
                                            <TextBlock Text="正常" FontSize="13" Foreground="#00b894"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- GPU 指标卡片 -->
                        <Border Classes="metric-card" IsVisible="{Binding ShowGpu}"
                                Background="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToBackgroundConverter.Instance}, ConverterParameter=GPU}"
                                BorderBrush="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToBorderConverter.Instance}, ConverterParameter=GPU}"
                                BoxShadow="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToShadowConverter.Instance}, ConverterParameter=GPU}"
                                Opacity="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToOpacityConverter.Instance}, ConverterParameter=GPU}"
                                PointerPressed="OnMetricCardClicked" Tag="GPU">
                            <Border.RenderTransform>
                                <media:ScaleTransform ScaleX="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToScaleConverter.Instance}, ConverterParameter=GPU}"
                                                ScaleY="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToScaleConverter.Instance}, ConverterParameter=GPU}"/>
                            </Border.RenderTransform>
                            <Grid>
                                <Border Height="1" VerticalAlignment="Top" Background="#40a29bfe" Margin="10,0"/>
                                <Border Width="1" HorizontalAlignment="Left" Background="#20a29bfe" Margin="0,10"/>
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="24" Height="24" CornerRadius="8" Background="{StaticResource GpuGlassGradient}">
                                                <TextBlock Text="G" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="GPU" FontSize="14" FontWeight="SemiBold" Foreground="#a29bfe" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding GpuUsage, StringFormat={}{0:F1}%}" FontSize="12" Foreground="#a29bfe" VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="{Binding GpuUsage, StringFormat={}{0:F1}%}" Classes="value" Foreground="{StaticResource TextPrimary}"/>
                                    <ProgressBar Value="{Binding GpuUsage}" Maximum="100" Classes="glass-progress-bar" Foreground="#a29bfe"/>

                                    <Grid ColumnDefinitions="*,*" Margin="0,5,0,0">
                                        <StackPanel>
                                            <TextBlock Text="温度" Classes="label"/>
                                            <TextBlock Text="{Binding GpuTemperature, StringFormat={}{0:F0}°C}" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="状态" Classes="label"/>
                                            <TextBlock Text="正常" FontSize="13" Foreground="#00b894"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 内存指标卡片 -->
                        <Border Classes="metric-card" IsVisible="{Binding ShowMemory}"
                                Background="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToBackgroundConverter.Instance}, ConverterParameter=Memory}"
                                BorderBrush="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToBorderConverter.Instance}, ConverterParameter=Memory}"
                                BoxShadow="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToShadowConverter.Instance}, ConverterParameter=Memory}"
                                Opacity="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToOpacityConverter.Instance}, ConverterParameter=Memory}"
                                PointerPressed="OnMetricCardClicked" Tag="Memory">
                            <Border.RenderTransform>
                                <media:ScaleTransform ScaleX="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToScaleConverter.Instance}, ConverterParameter=Memory}"
                                                ScaleY="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToScaleConverter.Instance}, ConverterParameter=Memory}"/>
                            </Border.RenderTransform>
                            <Grid>
                                <Border Height="1" VerticalAlignment="Top" Background="#40fd79a8" Margin="10,0"/>
                                <Border Width="1" HorizontalAlignment="Left" Background="#20fd79a8" Margin="0,10"/>
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="24" Height="24" CornerRadius="8" Background="{StaticResource MemoryGlassGradient}">
                                                <TextBlock Text="M" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="内存" FontSize="14" FontWeight="SemiBold" Foreground="#fd79a8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding MemoryUsage, StringFormat={}{0:F1}%}" FontSize="12" Foreground="#fd79a8" VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="{Binding MemoryUsage, StringFormat={}{0:F1}%}" Classes="value" Foreground="{StaticResource TextPrimary}"/>
                                    <ProgressBar Value="{Binding MemoryUsage}" Maximum="100" Classes="glass-progress-bar" Foreground="#fd79a8"/>

                                    <Grid ColumnDefinitions="*,*" Margin="0,5,0,0">
                                        <StackPanel>
                                            <TextBlock Text="已用" Classes="label"/>
                                            <TextBlock Text="{Binding MemoryUsedGB, StringFormat={}{0:F1} GB}" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="总计" Classes="label"/>
                                            <TextBlock Text="{Binding MemoryTotalGB, StringFormat={}{0:F1} GB}" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- FPS 指标卡片 -->
                        <Border Classes="metric-card" IsVisible="{Binding ShowFps}"
                                Background="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToBackgroundConverter.Instance}, ConverterParameter=FPS}"
                                BorderBrush="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToBorderConverter.Instance}, ConverterParameter=FPS}"
                                BoxShadow="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToShadowConverter.Instance}, ConverterParameter=FPS}"
                                Opacity="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToOpacityConverter.Instance}, ConverterParameter=FPS}"
                                PointerPressed="OnMetricCardClicked" Tag="FPS">
                            <Border.RenderTransform>
                                <media:ScaleTransform ScaleX="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToScaleConverter.Instance}, ConverterParameter=FPS}"
                                                ScaleY="{Binding SelectedMetricCard, Converter={x:Static converters:SelectedMetricToScaleConverter.Instance}, ConverterParameter=FPS}"/>
                            </Border.RenderTransform>
                            <Grid>
                                <Border Height="1" VerticalAlignment="Top" Background="#4076B900" Margin="10,0"/>
                                <Border Width="1" HorizontalAlignment="Left" Background="#2076B900" Margin="0,10"/>
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="24" Height="24" CornerRadius="8" Background="{StaticResource FpsGlassGradient}">
                                                <TextBlock Text="F" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="FPS" FontSize="14" FontWeight="SemiBold" Foreground="#76B900" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Fps, Converter={x:Static converters:FpsValueConverter.Instance}}" Classes="value" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="帧/秒" Classes="label" Margin="0,-5,0,0"/>

                                    <Grid ColumnDefinitions="*,*" Margin="0,5,0,0">
                                        <StackPanel>
                                            <TextBlock Text="响应时间" Classes="label"/>
                                            <TextBlock Text="{Binding AvgResponseTime, StringFormat={}{0:F1} ms}" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="错误/分钟" Classes="label"/>
                                            <TextBlock Text="{Binding ErrorsPerMinute}" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 指标过滤 -->
                        <Border Classes="glass-card-with-highlight" Padding="15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="显示指标" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <StackPanel Spacing="8">
                                    <CheckBox Content="CPU" IsChecked="{Binding ShowCpu}" Tag="CPU" Classes="glass-checkbox-item" Foreground="#4ecdc4"/>
                                    <CheckBox Content="GPU" IsChecked="{Binding ShowGpu}" Tag="GPU" Classes="glass-checkbox-item" Foreground="#a29bfe"/>
                                    <CheckBox Content="内存" IsChecked="{Binding ShowMemory}" Tag="Memory" Classes="glass-checkbox-item" Foreground="#fd79a8"/>
                                    <CheckBox Content="FPS" IsChecked="{Binding ShowFps}" Tag="FPS" Classes="glass-checkbox-item" Foreground="#76B900"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 右侧：图表和告警 -->
                <Grid Grid.Column="1" RowDefinitions="*,Auto" Margin="15,0,0,0">
                    <!-- 图表区域 -->
                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <!-- 时间范围选择 -->
                            <Border Classes="glass-card-with-highlight" Padding="16">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="时间范围" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                    <ComboBox SelectedIndex="2" Width="120" Classes="glass-dropdown" SelectionChanged="OnTimeRangeChanged">
                                        <ComboBoxItem Content="15分钟"/>
                                        <ComboBoxItem Content="30分钟"/>
                                        <ComboBoxItem Content="1小时"/>
                                        <ComboBoxItem Content="6小时"/>
                                        <ComboBoxItem Content="24小时"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <!-- CPU 图表 -->
                            <Border Classes="glass-card-with-highlight" Padding="16" IsVisible="{Binding ShowCpu}">
                                <StackPanel Spacing="12">
                                    <Border Height="1" VerticalAlignment="Top" Background="#404ecdc4" Margin="0,0,0,8"/>
                                    <TextBlock Text="CPU 使用率趋势" FontSize="14" FontWeight="SemiBold" Foreground="#4ecdc4"/>
                                    <lvc:CartesianChart Series="{Binding CpuSeries}" XAxes="{Binding DefaultXAxes}" YAxes="{Binding DefaultYAxes}" Height="180" Background="Transparent"/>
                                </StackPanel>
                            </Border>

                            <!-- GPU 图表 -->
                            <Border Classes="glass-card-with-highlight" Padding="16" IsVisible="{Binding ShowGpu}">
                                <StackPanel Spacing="12">
                                    <Border Height="1" VerticalAlignment="Top" Background="#40a29bfe" Margin="0,0,0,8"/>
                                    <TextBlock Text="GPU 使用率趋势" FontSize="14" FontWeight="SemiBold" Foreground="#a29bfe"/>
                                    <lvc:CartesianChart Series="{Binding GpuSeries}" XAxes="{Binding DefaultXAxes}" YAxes="{Binding DefaultYAxes}" Height="180" Background="Transparent"/>
                                </StackPanel>
                            </Border>

                            <!-- 内存图表 -->
                            <Border Classes="glass-card-with-highlight" Padding="16" IsVisible="{Binding ShowMemory}">
                                <StackPanel Spacing="12">
                                    <Border Height="1" VerticalAlignment="Top" Background="#40fd79a8" Margin="0,0,0,8"/>
                                    <TextBlock Text="内存使用率趋势" FontSize="14" FontWeight="SemiBold" Foreground="#fd79a8"/>
                                    <lvc:CartesianChart Series="{Binding MemorySeries}" XAxes="{Binding DefaultXAxes}" YAxes="{Binding DefaultYAxes}" Height="180" Background="Transparent"/>
                                </StackPanel>
                            </Border>

                            <!-- FPS 图表 -->
                            <Border Classes="glass-card-with-highlight" Padding="16" IsVisible="{Binding ShowFps}">
                                <StackPanel Spacing="12">
                                    <Border Height="1" VerticalAlignment="Top" Background="#4076B900" Margin="0,0,0,8"/>
                                    <TextBlock Text="FPS 帧率趋势" FontSize="14" FontWeight="SemiBold" Foreground="#76B900"/>
                                    <lvc:CartesianChart Series="{Binding FpsSeries}" XAxes="{Binding DefaultXAxes}" YAxes="{Binding FpsYAxes}" Height="180" Background="Transparent"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 告警区域 -->
                    <Border Grid.Row="1" Classes="glass-card-with-highlight" Padding="16" Margin="0,15,0,0" MaxHeight="220">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="活动告警" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Classes="glass-card-with-highlight" Padding="10,5" CornerRadius="10">
                                    <TextBlock Text="{Binding ActiveAlerts.Count, StringFormat={}{0} 个告警}" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding ActiveAlerts}" MaxHeight="160">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" CornerRadius="12" Background="{StaticResource LiquidGlassBase}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" Padding="12,10">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Width="8" Height="8" CornerRadius="4" Background="{Binding SeverityColor}" 
                                                        BoxShadow="0 0 12 0 #80ff6b6b" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding RuleName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="280"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding TimeAgo}" FontSize="10" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 底部状态栏 -->
            <Border Grid.Row="2" Classes="glass-header-bar" Padding="20,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="监控面板 v2.0" Classes="label"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
                        <Border Classes="glass-card-with-highlight" Padding="12,6" CornerRadius="15">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="CPU:" Classes="label" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:F1}%}" FontSize="13" FontWeight="SemiBold" Foreground="#4ecdc4"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="glass-card-with-highlight" Padding="12,6" CornerRadius="15">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="内存:" Classes="label" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MemoryUsage, StringFormat={}{0:F1}%}" FontSize="13" FontWeight="SemiBold" Foreground="#fd79a8"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="glass-card-with-highlight" Padding="12,6" CornerRadius="15">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="FPS:" Classes="label" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Fps, Converter={x:Static converters:FpsValueConverter.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="#76B900"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>