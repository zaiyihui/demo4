<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ComputerCompanion.ViewModels"
        mc:Ignorable="d" d:DesignWidth="180" d:DesignHeight="180"
        x:Class="ComputerCompanion.Views.OverlayWindow"
        x:DataType="vm:OverlayViewModel"
        Title="悬浮窗"
        Width="180"
        Height="200"
        Background="Transparent"
        TransparencyLevelHint="Blur"
        ShowInTaskbar="False"
        Topmost="True"
        ExtendClientAreaToDecorationsHint="True"
        SystemDecorations="None">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Microsoft YaHei UI, PingFang SC, sans-serif"/>
        </Style>

        <!-- 悬浮窗外层：中灰卡片 + 半透明白边 -->
        <Style Selector="Border.overlay-panel">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BoxShadow" Value="0 10 30 #35000000, 0 4 12 #18000000"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                        <BrushTransition Property="Background" Duration="0:0:0.3"/>
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Border.overlay-panel:pointerover">
            <Setter Property="Background" Value="{StaticResource CardBackgroundHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleStrong}"/>
            <Setter Property="BoxShadow" Value="0 14 40 #45000000, 0 6 16 #25000000"/>
        </Style>

        <!-- 拖拽手柄 -->
        <Style Selector="Border.overlay-drag-handle">
            <Setter Property="Background" Value="{StaticResource BackgroundSecondary}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="SizeAll"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                        <BrushTransition Property="Background" Duration="0:0:0.2"/>
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Border.overlay-drag-handle:pointerover">
            <Setter Property="Background" Value="{StaticResource CardBackgroundHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleStrong}"/>
        </Style>

        <!-- 标签样式 -->
        <Style Selector="TextBlock.overlay-label">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- FPS大数字 -->
        <Style Selector="TextBlock.overlay-fps-value">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentPrimary}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, monospace"/>
        </Style>

        <!-- 次级指标 -->
        <Style Selector="TextBlock.overlay-metric-value">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <!-- FPS详情 -->
        <Style Selector="TextBlock.overlay-fps-detail">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>

        <!-- VRAM详情 -->
        <Style Selector="TextBlock.overlay-vram-value">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>
    </Window.Styles>

    <Border Classes="overlay-panel">
        <Grid>
            <!-- 顶部微弱高光（Alpha通道编码透明度） -->
            <Border Height="1" VerticalAlignment="Top" Opacity="0.3" Margin="10,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#14ffffff" Offset="0"/>
                        <GradientStop Color="#0affffff" Offset="0.5"/>
                        <GradientStop Color="#00ffffff" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- 左侧微弱高光 -->
            <Border Width="1" HorizontalAlignment="Left" Opacity="0.2" Margin="0,8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0fffffff" Offset="0"/>
                        <GradientStop Color="#00ffffff" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 拖拽手柄 -->
                <Grid Grid.ColumnSpan="2" Grid.Row="0" Margin="0,0,0,8">
                    <Border Classes="overlay-drag-handle" HorizontalAlignment="Left"
                            PointerPressed="OnDragHandlePressed"
                            PointerMoved="OnDragHandleMoved"
                            PointerReleased="OnDragHandleReleased"
                            ToolTip.Tip="拖拽移动">
                        <TextBlock Text="≡" FontSize="11" Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- FPS 行 -->
                <TextBlock Grid.Column="0" Grid.Row="1" Text="FPS" Classes="overlay-label" Margin="4,4,4,2"/>
                <TextBlock Grid.Column="1" Grid.Row="1" x:DataType="vm:OverlayViewModel" Text="{Binding FpsText}" Classes="overlay-fps-value" HorizontalAlignment="Right" Margin="0,4,6,2"/>

                <!-- 1% Low -->
                <TextBlock Grid.Column="0" Grid.Row="2" Text="1%" Classes="overlay-label" Opacity="0.7" Margin="4,2,4,2"/>
                <TextBlock Grid.Column="1" Grid.Row="2" x:DataType="vm:OverlayViewModel" Text="{Binding Fps1PercentLowText}" Classes="overlay-fps-detail" HorizontalAlignment="Right" Margin="0,2,6,2" IsVisible="{Binding ShowFpsDetails}"/>

                <!-- Frame Time -->
                <TextBlock Grid.Column="0" Grid.Row="3" Text="FT" Classes="overlay-label" Opacity="0.7" Margin="4,2,4,2"/>
                <TextBlock Grid.Column="1" Grid.Row="3" x:DataType="vm:OverlayViewModel" Text="{Binding FrameTimeText}" Classes="overlay-fps-detail" HorizontalAlignment="Right" Margin="0,2,6,2" IsVisible="{Binding ShowFpsDetails}"/>

                <!-- GPU 行 -->
                <TextBlock Grid.Column="0" Grid.Row="4" Text="GPU" Classes="overlay-label" Margin="4,4,4,2" IsVisible="{Binding ShowGpu}"/>
                <TextBlock Grid.Column="1" Grid.Row="4" x:DataType="vm:OverlayViewModel" Text="{Binding GpuText}" Classes="overlay-metric-value" HorizontalAlignment="Right" Margin="0,4,6,2" IsVisible="{Binding ShowGpu}" Foreground="{StaticResource AccentSecondary}"/>

                <!-- CPU 行 -->
                <TextBlock Grid.Column="0" Grid.Row="5" Text="CPU" Classes="overlay-label" Margin="4,4,4,2" IsVisible="{Binding ShowCpu}"/>
                <TextBlock Grid.Column="1" Grid.Row="5" x:DataType="vm:OverlayViewModel" Text="{Binding CpuText}" Classes="overlay-metric-value" HorizontalAlignment="Right" Margin="0,4,6,2" IsVisible="{Binding ShowCpu}" Foreground="{StaticResource AccentPrimary}"/>

                <!-- MEM 行 -->
                <TextBlock Grid.Column="0" Grid.Row="6" Text="MEM" Classes="overlay-label" Margin="4,4,4,2" IsVisible="{Binding ShowMemory}"/>
                <TextBlock Grid.Column="1" Grid.Row="6" x:DataType="vm:OverlayViewModel" Text="{Binding MemoryText}" Classes="overlay-metric-value" HorizontalAlignment="Right" Margin="0,4,6,2" IsVisible="{Binding ShowMemory}" Foreground="{StaticResource AccentTertiary}"/>

                <!-- VRAM 行 -->
                <TextBlock Grid.Column="0" Grid.Row="7" Text="VRAM" Classes="overlay-label" Margin="4,4,4,4" IsVisible="{Binding ShowVram}"/>
                <TextBlock Grid.Column="1" Grid.Row="7" x:DataType="vm:OverlayViewModel" Text="{Binding VramText}" Classes="overlay-vram-value" HorizontalAlignment="Right" Margin="0,4,6,4" IsVisible="{Binding ShowVram}"/>
            </Grid>

            <!-- 底部微弱发光边缘：荧光绿线性渐变（Alpha通道编码透明度） -->
            <Border Height="1" VerticalAlignment="Bottom" Opacity="0.5" Margin="12,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0000db78" Offset="0"/>
                        <GradientStop Color="#9900db78" Offset="0.5"/>
                        <GradientStop Color="#0000db78" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>
    </Border>
</Window>
