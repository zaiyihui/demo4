<Project>
  <!--
    ==================================================
    MSBuild 内存优化配置 - 激进模式
    ==================================================
    针对构建过程中内存占用过高问题的全面解决方案：
    
    核心问题分析：
    1. SkiaSharp/LiveCharts2 包含大量原生代码，每次构建都需要处理
    2. Avalonia XAML 编译和资源处理非常耗时
    3. 增量构建缓存失效导致全量重建
    4. NuGet 包解析和验证消耗大量资源
    5. SkiaSharp 在构建时生成大量绑定代码

    解决方案：
    - 限制构建进程数量为1
    - 禁用所有不必要的构建服务
    - 优化增量构建缓存策略
    - 减少内存分配和垃圾回收压力
    ==================================================
  -->

  <!--
    全局内存优化设置
  -->
  <PropertyGroup>
    <!-- 强制单进程构建，避免内存竞争 -->
    <MaxCPUCount>1</MaxCPUCount>
    <BuildInParallel>false</BuildInParallel>
    <UseSharedCompilation>false</UseSharedCompilation>

    <!-- 禁用 MSBuild 节点重用，减少内存泄漏风险 -->
    <NodeReuse>false</NodeReuse>

    <!-- 启用增量构建检查 -->
    <DisableFastUpToDateCheck>false</DisableFastUpToDateCheck>
    <EnableIncrementalBuild>true</EnableIncrementalBuild>

    <!-- 减少构建日志输出 -->
    <MSBuildWarningsAsMessages>NETSDK1047;AVLN3001;CS0067;NU1605</MSBuildWarningsAsMessages>

    <!-- 禁用跨目标构建优化（减少内存使用） -->
    <DisableCrossTargetingOptimizations>true</DisableCrossTargetingOptimizations>

    <!-- 减少文件系统监听（减少内存） -->
    <EnableFileSystemWatching>false</EnableFileSystemWatching>

    <!-- 禁用生成器缓存 -->
    <EnableGeneratedFileCache>false</EnableGeneratedFileCache>
  </PropertyGroup>

  <!--
    禁用所有构建服务器
  -->
  <PropertyGroup>
    <UseRazorBuildServer>false</UseRazorBuildServer>
    <UseSharedCompilation>false</UseSharedCompilation>
    <UseRoslynBuildServer>false</UseRoslynBuildServer>
    <UseVBCSCompilerServer>false</UseVBCSCompilerServer>
  </PropertyGroup>

  <!--
    针对 Avalonia 项目的特殊优化
  -->
  <PropertyGroup>
    <!-- 跳过 Avalonia 的 XAML 预编译（减少内存） -->
    <AvaloniaCompileXaml Condition="'$(Configuration)' == 'Debug'">false</AvaloniaCompileXaml>

    <!-- 禁用 Avalonia 的资源预编译 -->
    <AvaloniaResourcePreCompile Condition="'$(Configuration)' == 'Debug'">false</AvaloniaResourcePreCompile>

    <!-- 禁用 Avalonia 设计器支持 -->
    <EnableAvaloniaDesigner>false</EnableAvaloniaDesigner>
  </PropertyGroup>

  <!--
    针对 Debug 配置的深度优化
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
    <DebugSymbols>true</DebugSymbols>

    <!-- 完全禁用代码分析 -->
    <RunAnalyzers>false</RunAnalyzers>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>false</RunAnalyzersDuringLiveAnalysis>

    <!-- 禁用 XML 文档生成 -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- 禁用 Source Link -->
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>

    <!-- 禁用增量编译（减少内存，Debug 模式下增量收益不大） -->
    <IncrementalCompilerEnabled>false</IncrementalCompilerEnabled>

    <!-- 禁用 ReadyToRun 编译 -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <ReadyToRunOptimization>false</ReadyToRunOptimization>
  </PropertyGroup>

  <!--
    针对 Release 配置的优化
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!-- 禁用代码分析以加快构建 -->
    <RunAnalyzers>false</RunAnalyzers>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
  </PropertyGroup>

  <!--
    针对 SkiaSharp 的特殊优化
  -->
  <PropertyGroup>
    <!-- 禁用 SkiaSharp 的代码生成优化（减少内存） -->
    <SkiaSharpEnableManagedCodeGen>false</SkiaSharpEnableManagedCodeGen>
    <SkiaSharpEnableUnsafeCodeGen>false</SkiaSharpEnableUnsafeCodeGen>
  </PropertyGroup>

  <!--
    禁用不必要的 NuGet 功能
  -->
  <PropertyGroup>
    <!-- 禁用 NuGet 包签名验证 -->
    <NuGetRequireSignatureValidation>false</NuGetRequireSignatureValidation>
    
    <!-- 禁用包源映射 -->
    <DisablePackageSourceMapping>true</DisablePackageSourceMapping>
  </PropertyGroup>

  <!--
    构建缓存优化
  -->
  <PropertyGroup>
    <!-- 使用共享缓存位置 -->
    <CacheRoot>$(LocalAppData)\Microsoft\MSBuild\Cache</CacheRoot>
    
    <!-- 启用构建缓存 -->
    <EnableBuildCache>true</EnableBuildCache>
    
    <!-- 缓存过期时间（7天） -->
    <BuildCacheExpiration>7.00:00:00</BuildCacheExpiration>
  </PropertyGroup>

  <!--
    输出路径配置（确保一致性）
  -->
  <PropertyGroup>
    <OutputPath>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)</OutputPath>
    <IntermediateOutputPath>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)</IntermediateOutputPath>
  </PropertyGroup>
</Project>
